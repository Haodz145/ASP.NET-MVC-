@{
    ViewBag.Title = "Đổi mật khẩu";
}
<div class="box box-primary">
    <div class="box-body">
        <form action="~/Employee/SavePassword" method="post">
            <input type="hidden" name="EmployeeID" value="1" />

            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Nhân viên:</label>
                <div class="col-sm-10">
                    <p class="form-control-plaintext font-weight-bold">Nguyễn Quản Lý</p>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Mật khẩu mới:</label>
                <div class="col-sm-10">
                    <input type="password" class="form-control" name="NewPassword" required>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Lưu mật khẩu
                    </button>
                    <a href="~/Employee" class="btn btn-default">Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>