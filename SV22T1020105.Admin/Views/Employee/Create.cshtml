@{ ViewBag.Title = "Bổ sung Nhân viên"; }
<div class="box box-primary">
    <div class="box-body">
        <form action="~/Employee/Save" method="post" enctype="multipart/form-data">
            <input type="hidden" name="EmployeeID" value="0" />
            
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Họ và tên:</label>
                <div class="col-sm-10"><input type="text" class="form-control" name="FullName" required autofocus></div>
            </div>
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Email:</label>
                <div class="col-sm-10"><input type="email" class="form-control" name="Email" required></div>
            </div>
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Mật khẩu:</label>
                <div class="col-sm-10"><input type="password" class="form-control" name="Password" required></div>
            </div>
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Ảnh đại diện:</label>
                <div class="col-sm-10"><input type="file" class="form-control" name="uploadPhoto"></div>
            </div>
            
            <div class="form-group row">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu dữ liệu</button>
                    <a href="~/Employee" class="btn btn-default">Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>