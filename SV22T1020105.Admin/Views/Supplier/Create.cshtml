@{
    ViewBag.Title = "Quản lý Nhà cung cấp";
}

<div class="box box-primary">
    <div class="box-body">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">Thông tin nhà cung cấp</h3>
            </div>

            <div class="card-body">
                <form action="~/Supplier/Save" method="post">

                    <input type="hidden" name="SupplierID" value="0" />

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Tên nhà cung cấp:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" name="SupplierName" autofocus required>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Tên giao dịch:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" name="ContactName" required>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Điện thoại:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" name="Phone">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Email:</label>
                        <div class="col-sm-10">
                            <input type="email" class="form-control" name="Email">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Địa chỉ:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" name="Address">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Tỉnh/Thành:</label>
                        <div class="col-sm-10">
                            <select class="form-control" name="Province">
                                <option value="">-- Chọn Tỉnh/Thành --</option>
                                <option value="Hà Nội">Hà Nội</option>
                                <option value="Hồ Chí Minh">Hồ Chí Minh</option>
                                <option value="Đà Nẵng">Đà Nẵng</option>
                                <option value="Thừa Thiên Huế">Thừa Thiên Huế</option>
                                <option value="Cần Thơ">Cần Thơ</option>
                                <option value="Hải Phòng">Hải Phòng</option>
                                <option value="Quảng Nam">Quảng Nam</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lưu dữ liệu
                            </button>
                            <a href="~/Supplier" class="btn btn-default">
                                Quay lại
                            </a>
                        </div>
                    </div>

                </form>
                </div>
        </div>
    </div>
</div>