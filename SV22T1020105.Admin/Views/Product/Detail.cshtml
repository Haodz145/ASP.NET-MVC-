@{ ViewBag.Title = "Chi tiết Mặt hàng"; }
<div class="box box-info">
    <div class="box-body">
        <div class="row">
            <div class="col-md-4 text-center">
                <img src="https://via.placeholder.com/300" class="img-thumbnail" alt="Product Image">
            </div>
            <div class="col-md-8">
                <h3>iPhone 15 Pro Max</h3>
                <p><strong>Mã hàng:</strong> SP001</p>
