@{ ViewBag.Title = "Bổ sung Người giao hàng"; }
<div class="box box-primary">
    <div class="box-body">
        <form action="~/Shipper/Save" method="post">
            <input type="hidden" name="ShipperID" value="0" />
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Tên người giao hàng:</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" name="ShipperName" autofocus required placeholder="Nhập tên đơn vị vận chuyển">
                </div>
            </div>
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Điện thoại:</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" name="Phone">
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu dữ liệu</button>
                    <a href="~/Shipper" class="btn btn-default">Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>