@{
    ViewData["Title"] = "Khách hàng";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Thông tin khách hàng</h3>
    </div>

    <div class="card-body">
        <form asp-controller="Customer" asp-action="Save" method="post">

            <!-- Tên khách hàng -->
            <div class="mb-3">
                <label class="form-label">Tên khách hàng</label>
                <input type="text"
                       name="CustomerName"
                       class="form-control"
                       placeholder="Nhập tên khách hàng"
                       required />
            </div>

            <!-- Tên giao dịch -->
            <div class="mb-3">
                <label class="form-label">Tên giao dịch</label>
                <input type="text"
                       name="ContactName"
                       class="form-control"
                       placeholder="Nhập tên giao dịch" />
            </div>

            <!-- Điện thoại -->
            <div class="mb-3">
                <label class="form-label">Điện thoại</label>
                <input type="text"
                       name="Phone"
                       class="form-control"
                       placeholder="Nhập số điện thoại" />
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email"
                       name="Email"
                       class="form-control"
                       placeholder="Nhập email" />
            </div>

            <!-- Địa chỉ -->
            <div class="mb-3">
                <label class="form-label">Địa chỉ</label>
                <input type="text"
                       name="Address"
                       class="form-control"
                       placeholder="Nhập địa chỉ" />
            </div>

            <!-- Tỉnh/Thành -->
            <div class="mb-3">
                <label class="form-label">Tỉnh/Thành</label>
                <select name="Province"
                        class="form-select">
                    <option value="">-- Chọn tỉnh/thành --</option>
                    @foreach (var item in ViewBag.Provinces)
                    {
                        <option value="@item.ProvinceName">
                            @item.ProvinceName
                        </option>
                    }
                </select>
            </div>

            <!-- Trạng thái -->
            <div class="mb-3">
                <label class="form-label">Trạng thái</label>
                <select name="IsLocked" class="form-select">
                    <option value="false">Đang hoạt động</option>
                    <option value="true">Bị khóa</option>
                </select>
            </div>

            <!-- Buttons -->
            <div class="text-end">
                <button type="submit" class="btn btn-primary me-2">
                    Lưu dữ liệu
                </button>
                <a href="~/Customer" class="btn btn-secondary">
                    Bỏ qua
                </a>
            </div>

        </form>
    </div>
</div>
