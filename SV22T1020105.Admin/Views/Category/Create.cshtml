@{ ViewBag.Title = "Bổ sung Loại hàng"; }
<div class="box box-primary">
    <div class="box-body">
        <form action="~/Category/Save" method="post">
            <input type="hidden" name="CategoryID" value="0" />
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Tên loại hàng:</label>
                <div class="col-sm-10"><input type="text" class="form-control" name="CategoryName" required autofocus></div>
            </div>
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Mô tả:</label>
                <div class="col-sm-10"><textarea class="form-control" name="Description" rows="3"></textarea></div>
            </div>
            <div class="form-group row">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary">Lưu dữ liệu</button>
                    <a href="~/Category" class="btn btn-default">Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>