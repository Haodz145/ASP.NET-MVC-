@{ ViewBag.Title = "Bổ sung Thuộc tính cho Loại hàng"; }
<div class="box box-primary">
    <div class="box-body">
        <form action="~/Category/SaveAttribute" method="post">
            <input type="hidden" name="AttributeID" value="0" />
            <input type="hidden" name="CategoryID" value="1" /> <div class="form-group row">
                <label class="col-sm-2 col-form-label">Tên thuộc tính:</label>
                <div class="col-sm-10"><input type="text" class="form-control" name="AttributeName" required placeholder="Ví dụ: Màu sắc, Kích thước..."></div>
            </div>
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Thứ tự hiển thị:</label>
                <div class="col-sm-10"><input type="number" class="form-control" name="DisplayOrder" value="1"></div>
            </div>
            <div class="form-group row">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary">Lưu thuộc tính</button>
                    <a href="~/Category/ListAttribute/1" class="btn btn-default">Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>