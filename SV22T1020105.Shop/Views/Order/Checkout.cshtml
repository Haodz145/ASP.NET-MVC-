@{
    ViewBag.Title = "Đặt hàng";
    var cart = ViewBag.Cart as List<SV22T1020105.Models.Sales.OrderDetailViewInfo> ?? new();
    decimal total = cart.Sum(x => x.Quantity * x.SalePrice);
}

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">📦 Thông tin giao hàng</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Order/Checkout">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Tỉnh/Thành phố giao hàng <span class="text-danger">*</span></label>
                        <input type="text" name="deliveryProvince" class="form-control"
                               placeholder="Ví dụ: TP. Hồ Chí Minh" autofocus required />
                        <span class="text-danger small">
                            @(ViewData.ModelState["deliveryProvince"]?.Errors.FirstOrDefault()?.ErrorMessage)
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                        <input type="text" name="deliveryAddress" class="form-control"
                               placeholder="Số nhà, đường, phường/xã, quận/huyện..." required />
                        <span class="text-danger small">
                            @(ViewData.ModelState["deliveryAddress"]?.Errors.FirstOrDefault()?.ErrorMessage)
                        </span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg">✅ Xác nhận đặt hàng</button>
                        <a asp-controller="Cart" asp-action="ViewCart" class="btn btn-outline-secondary">
                            ← Quay lại giỏ hàng
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0">📋 Đơn hàng của bạn</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var item in cart)
                        {
                            <tr>
                                <td>@item.ProductName <span class="text-muted">x@item.Quantity</span></td>
                                <td class="text-end">@((item.Quantity * item.SalePrice).ToString("N0")) đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td class="fw-bold">Tổng cộng:</td>
                            <td class="text-end fw-bold text-danger">@total.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
