@model SV22T1020105.Models.Sales.OrderViewInfo
@{
    ViewBag.Title = "Đặt hàng thành công";
    var details = ViewBag.Details as List<SV22T1020105.Models.Sales.OrderDetailViewInfo> ?? new();
    decimal total = details.Sum(x => x.Quantity * x.SalePrice);
}

<div class="text-center mb-4">
    <div class="display-1 text-success">✅</div>
    <h3 class="text-success">Đặt hàng thành công!</h3>
    <p class="text-muted">Cảm ơn bạn đã mua hàng. Đơn hàng của bạn đang được xử lý.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white">
                <strong>Đơn hàng #@Model.OrderID</strong>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-5 text-muted">Ngày đặt hàng:</div>
                    <div class="col-7">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Tỉnh/Thành giao hàng:</div>
                    <div class="col-7">@Model.DeliveryProvince</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Địa chỉ giao hàng:</div>
                    <div class="col-7">@Model.DeliveryAddress</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Trạng thái:</div>
                    <div class="col-7">
                        <span class="badge bg-warning text-dark">@Model.Status.GetDescription()</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">Chi tiết đơn hàng</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in details)
                        {
                            <tr>
                                <td>@item.ProductName <small class="text-muted">(@item.Unit)</small></td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.SalePrice.ToString("N0") đ</td>
                                <td class="text-end">@((item.Quantity * item.SalePrice).ToString("N0")) đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="text-end fw-bold text-danger">@total.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Order" asp-action="History" class="btn btn-outline-primary">
                📋 Xem lịch sử đơn hàng
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                🛍️ Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>
