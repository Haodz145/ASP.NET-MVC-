@{
    ViewBag.Title = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">🔑 Đổi mật khẩu</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Account/ChangePassword">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu cũ</label>
                        <input type="password" name="oldPassword" class="form-control"
                               placeholder="Nhập mật khẩu hiện tại" autofocus />
                        <span class="text-danger small">
                            @(ViewData.ModelState["oldPassword"]?.Errors.FirstOrDefault()?.ErrorMessage)
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <input type="password" name="newPassword" class="form-control"
                               placeholder="Ít nhất 6 ký tự" />
                        <span class="text-danger small">
                            @(ViewData.ModelState["newPassword"]?.Errors.FirstOrDefault()?.ErrorMessage)
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Xác nhận mật khẩu mới</label>
                        <input type="password" name="confirmPassword" class="form-control"
                               placeholder="Nhập lại mật khẩu mới" />
                        <span class="text-danger small">
                            @(ViewData.ModelState["confirmPassword"]?.Errors.FirstOrDefault()?.ErrorMessage)
                        </span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Đổi mật khẩu</button>
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
